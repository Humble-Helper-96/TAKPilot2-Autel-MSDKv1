<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Exterior LEDs OFF: the same bulb with a slash through it.
         Pair of ic_led_on — see that file for why the colours are explicit and not a tint.

         THE SLASH IS DRAWN TWICE, toolbar-blue then white. The button sits on the blue action
         bar (bg_toolbar, #0D47A1), so the under-stroke is that exact blue: it reads as a gap
         cut through the bulb rather than as a second line. A single white slash over a white
         bulb would be nearly invisible, and this is the icon a pilot checks to confirm the
         aircraft is actually dark.

         If this button is ever moved off the blue bar, the #0D47A1 under-stroke must change to
         whatever is behind it. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,21c0,0.55 0.45,1 1,1h4c0.55,0 1,-0.45 1,-1v-1L9,20v1zM12,2C8.14,2 5,5.14 5,9c0,2.38 1.19,4.47 3,5.74L8,17c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1v-2.26c1.81,-1.27 3,-3.36 3,-5.74 0,-3.86 -3.14,-7 -7,-7z" />
    <path
        android:strokeColor="#0D47A1"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M3.5,3.5 L20.5,20.5" />
    <path
