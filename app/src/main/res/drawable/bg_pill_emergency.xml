<?xml version="1.0" encoding="utf-8"?>
<!-- The ACTIVE state of the Emergency Broadcast pill (v2.3.9), shown only while the override is
     running. Its own hue — tp_state_emergency — not a reuse of bg_pill_active's green: this is a
     distinct, audited override action, not a feature toggle, and must read as something
     different from "AR is on" at a glance. See takpilot_colors.xml's note on tp_state_emergency.

     ⚠ SAME GEOMETRY AS bg_zoom_pill/bg_pill_active — see those files' notes. A control that
     changes size when it turns on reads as a different control; only the colour carries state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/hud_pill_radius" />
    <solid android:color="@color/tp_pill_emergency_fill" />
    <stroke android:width="@dimen/hud_pill_stroke" android:color="@color/tp_state_emergency" />
</shape>
