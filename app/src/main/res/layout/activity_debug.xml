<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/tp_bg_home"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: options column -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug Log"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Options" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="6dp">
                <CheckBox android:id="@+id/debugLoggingToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Logging enabled" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugVerboseToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Detailed (all app functions)" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugTakToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include TAK / CoT logs" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="Clear this box to hide the TAK messages and show only the app."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugRadarToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include obstacle radar logs" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="The radar fills the log. Select this box only to examine obstacle avoidance. Avoidance changes and warnings stay in the log."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugResourceMonitorToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Show system resources on flight screen" android:textColor="@color/tp_text_bright" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="Adds a small panel on the flight screen with memory and contact-count numbers. Use it to watch the system before a crash."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <!-- Autel Explorer watchdog — a single on/off toggle. Kills Explorer's background
                 process when it tries to take the aircraft link. No permanent change to the
                 controller; Explorer opens normally when the pilot opens it. -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="Autel Explorer" android:textColor="@color/tp_text_primary"
                android:textSize="16sp" android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugExplorerToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="@color/tp_btn_info" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Close Explorer if it takes the aircraft link" android:textColor="@color/tp_text_bright"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/debugExplorerStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="4dp"
                android:text="Autel Explorer can start on its own and stop the video with no warning. This option prevents that. It does not change Explorer."
                android:textColor="@color/tp_text_caption" android:textSize="12sp" />

            <!-- RF power probe (2026-08-07, for Autel support): exercises the ONLY transmit
                 power control the SDK exposes (setRFPower FCC/CE) with read-backs, and logs
                 every step — evidence for whether the RC accepts or ignores the change.
                 Bench tool; ends by restoring FCC, the fleet's configured region. -->
            <Button
            style="@style/TakButton.Neutral"
                android:id="@+id/debugRfPowerProbe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="RF Power Probe (bench)" />
            <!-- "Export Log" was here until 2026-08-16. Every log is already written to
                 Downloads/TAKPilot2 Logs as it is produced, so the button offered a second
                 route to a file the pilot already has (operator). -->
            <Button
            style="@style/TakButton.Neutral"
                android:id="@+id/debugClearButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Clear Log" />
            <Button
            style="@style/TakButton.Danger"
                android:id="@+id/debugDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delete Log" />
        </LinearLayout>

        <TextView
            android:id="@+id/debugLogMeta"
            style="@style/homeCardSub"
            android:layout_marginTop="10dp"
            android:text="" />

        <TextView
            style="@style/homeCardSub"
            android:layout_marginTop="4dp"
            android:text="Also archived to Downloads/TAKPilot2 Logs" />

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: live-scrolling log view -->
    <ScrollView
        android:id="@+id/debugLogScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:background="@color/tp_surface_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/debugLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/tp_state_go_soft"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>
</LinearLayout>
