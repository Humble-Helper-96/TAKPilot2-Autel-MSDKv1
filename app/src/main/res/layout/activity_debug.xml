<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0E0E10"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: options column -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debug Log"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Options" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="6dp">
                <CheckBox android:id="@+id/debugLoggingToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Logging enabled" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugVerboseToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Detailed (all app functions)" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugTakToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include TAK / CoT logs" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="Uncheck to hide the TAK bridge/CoT chatter (2s telemetry push, TakManager, CotParser) and leave only app logs — video, camera, DTED, UI."
                android:textColor="#7A7A7A" android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugRadarToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Include obstacle radar logs" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="The radar reports continuously and fills the log. Leave this off unless you are examining obstacle avoidance. Avoidance switch changes and warnings are always kept."
                android:textColor="#7A7A7A" android:textSize="12sp" />

            <!-- Autel Explorer suppression. Lives on the Debug screen, not Pre-Flight: it is a
                 provisioning-level control, and the restore button here is the pilot-reachable
                 escape hatch if Explorer is ever left hidden. -->
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="Autel Explorer" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/debugExplorerStatus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:textColor="#9E9E9E" android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="4dp">
                <CheckBox android:id="@+id/debugExplorerToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Keep Explorer closed while this app runs" android:textColor="#DDDDDD"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="2dp"
                android:text="Autel Explorer can start on its own and take the drone link, which stops the video with no warning. This keeps it closed. Explorer comes back when you close this app. You need Explorer for firmware updates, compass calibration and registration."
                android:textColor="#7A7A7A" android:textSize="12sp" />

            <Button
                android:id="@+id/debugExplorerRestoreButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Restore Explorer now"
                android:textColor="#FFFFFF" android:backgroundTint="#37474F" />

            <Button
                android:id="@+id/debugExplorerDeprovisionButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remove device-owner rights"
                android:textColor="#FFFFFF" android:backgroundTint="#5C2E2E" />

            <Button
                android:id="@+id/debugExportButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Export Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
            <Button
                android:id="@+id/debugClearButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Clear Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/debugDeleteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delete Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C" />
        </LinearLayout>

        <TextView
            android:id="@+id/debugLogMeta"
            style="@style/homeCardSub"
            android:layout_marginTop="10dp"
            android:text="" />

        <TextView
            style="@style/homeCardSub"
            android:layout_marginTop="4dp"
            android:text="Also archived to Downloads/TAKPilot2 Logs" />

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: live-scrolling log view -->
    <ScrollView
        android:id="@+id/debugLogScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.4"
        android:background="#1A1B1E"
        android:padding="12dp">

        <TextView
            android:id="@+id/debugLogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#CCFFCC"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>
</LinearLayout>
