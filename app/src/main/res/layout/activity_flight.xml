<?xml version="1.0" encoding="utf-8"?>
<!-- TAKPilot2-Autel flight screen.

     Fullscreen live video (AutelCodecView is added to videoContainer in code — it isn't a
     stock inflatable view), HUD strips top + bottom, control buttons on the right, and an
     osmdroid TAK map bottom-left that toggles between mini and (near) fullscreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tp_bg_flight"
    android:keepScreenOn="true">

    <!-- Live video (AutelCodecView injected here) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- AR marker overlay. BELOW the crosshair deliberately: the crosshair is the aiming
         reference for marker drops and must never be occluded by a projected marker. Hidden
         until the pilot turns it on. -->
    <com.autel.sdksample.tak.ArOverlayView
        android:id="@+id/flightArOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Obstacle proximity arcs on the video edges, one per aircraft face.

         ABOVE the AR overlay and BELOW the crosshair. A contact marker may be occluded by a
         collision warning; the reverse must never happen, and the crosshair stays on top for
         the same reason it sits above the AR layer — it is the aiming reference for drops. -->
    <com.autel.sdksample.tak.ObstacleEdgeView
        android:id="@+id/flightObstacleEdges"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centre reticle over the video: sighting reference, and its ring carries the
         marker-accuracy cue driven by gimbal pitch. Matches the DJI blueprint. -->
    <com.autel.sdksample.tak.CrosshairView
        android:id="@+id/flightCrosshair"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown until the aircraft connects. DJI hides its equivalent on the first decoded
         frame; AutelCodecView is an opaque SDK widget with no frame callback, so aircraft
         connection is the closest honest proxy available — see updateHud(). -->
    <TextView
        android:id="@+id/flightNoVideoCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tp_bg_screen"
        android:gravity="center"
        android:text="Waiting for aircraft…"
        android:textColor="@color/tp_text_hint"
        android:textSize="16sp"
        android:visibility="visible" />

    <!-- Instrument toolbar: TAK status, battery, GPS, RTH — same instrument cluster as the
         current DJI flight screen's toolbar, ported 2026-07-30. Signal-strength bars are
         deliberately NOT here yet: the Autel SDK's signal data (EvoDsp/SignalInfo) is raw
         RF metrics (RSRP/SNR/gain), not a 0-100% figure, and deriving one needs bench
         calibration against real hardware (Phase 4) — showing a fabricated number would be
         worse than not showing one. -->
    <LinearLayout
        android:id="@+id/flightToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/flightBackButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Home"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu" />

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <FrameLayout
            android:id="@+id/toolbarTakButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="TAK server connection">

            <ImageView
                android:id="@+id/toolbarTakIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter"
                android:contentDescription="TAK server connection"
                android:src="@drawable/ic_tak_logo" />

            <ImageView
                android:id="@+id/toolbarTakDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|start"
                android:src="@drawable/bg_status_dot" />

        </FrameLayout>

        <com.autel.sdksample.tak.BatteryGaugeView
            android:id="@+id/toolbarBattery"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="Battery" />

        <com.autel.sdksample.tak.SignalBarsView
            android:id="@+id/toolbarSignal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="RC signal strength" />

        <TextView
            android:id="@+id/toolbarSignalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:alpha="0.4"
            android:text="—%"
            android:textColor="@color/tp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/toolbarGpsIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="GPS satellites"
            android:src="@drawable/ic_gps" />

        <TextView
            android:id="@+id/toolbarGps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:text="—"
            android:textColor="@color/tp_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/flightRthButton"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Return to home"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rth" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Drop-pin heads the right-hand cluster and is the LARGEST control in the bar: it's
             the most-used action on this screen and a pilot reaching for it is usually also
             flying, so it has to be hittable without aiming. Same sizing/placement as DJI. -->
        <ImageButton
            android:id="@+id/flightDropPinButton"
            android:layout_width="56dp"
            android:layout_height="46dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Drop a TAK marker at the camera crosshair"
            android:padding="1dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_drop_pin" />

        <!-- Tap toggles the AR overlay; long-press opens AR options. -->
        <TextView
            android:id="@+id/flightArButton"
            android:layout_marginStart="16dp"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle AR marker overlay"
            android:gravity="center"
            android:text="AR"
            android:textColor="@color/tp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Framed like the AR / zoom / IR pills rather than a bare icon: it sits in the same
             run of camera controls, and a borderless glyph next to three outlined pills read
             as a different class of control than it is. Keeps the shutter glyph — the action
             is recognised faster from the icon than from a word. -->
        <ImageButton
            android:id="@+id/flightShootPhotoButton"
            android:layout_marginStart="16dp"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Take photo (saves to aircraft SD card)"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera_shutter" />

        <!-- Zoom pill. 54dp wide, not the original 46: the right scroll wheel puts fractional
             values in here ("2.4X"), which is four glyphs where the stepped labels were two.
             Widened rather than shrinking the text — this is read at a glance in sunlight. -->
        <TextView
            android:id="@+id/flightZoomButton"
            android:layout_marginStart="16dp"
            android:layout_width="54dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Camera zoom — tap to step, right wheel to adjust"
            android:gravity="center"
            android:text="1X"
            android:textColor="@color/tp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Thermal: switches the FPV between the visible camera and the 640T's IR sensor.
             Sits next to the zoom pill because both change what the camera is showing rather
             than what the app does with it. -->
        <TextView
            android:id="@+id/flightIrButton"
            android:layout_marginStart="16dp"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Toggle thermal (IR) camera"
            android:gravity="center"
            android:text="IR"
            android:textColor="@color/tp_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- Framed to match the AR / camera / zoom / IR pills — it is the last of the run of
             image controls and a bare glyph among framed ones reads as a different class of
             control. Same 46x34 as the rest. -->
        <ImageButton
            android:id="@+id/flightLightsButton"
            android:layout_marginStart="16dp"
            android:layout_width="46dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_zoom_pill"
            android:contentDescription="Exterior lights"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_led_on" />

        <com.autel.sdksample.tak.LiveToggleView
            android:id="@+id/flightStreamButton"
            android:layout_marginStart="16dp"
            android:layout_width="82dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop the RTSP video stream to TAK" />

        <com.autel.sdksample.tak.RecordToggleView
            android:id="@+id/flightRecordButton"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="6dp"
            android:layout_width="74dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Start/stop recording to the aircraft SD card" />

    </LinearLayout>

    <!-- Debug-only live resource monitor (memory/CPU/GPU/contact count), one line across the
         bottom. Off by default — see AppLog.resourceMonitor / ResourceMonitor.kt. Deliberately
         plain monospace on a dark chip, matching the Debug Log screen's style, since this is a
         diagnostic aid, not a normal-flight HUD element. Placed AFTER flightNoVideoCover in
         z-order (declared earlier above) so it stays visible even while that full-screen
         "Waiting for aircraft…" cover is showing — it needs to be watchable before a connection
         is up, not just once flying.

         Positioned to match the mini-map exactly (operator's spec, 2026-08-04): bottom edge
         level with the map's bottom, spanning the screen's left edge to the map's left edge,
         with its five cells evenly spaced across that span. marginEnd is
         @dimen/flight_resource_row_margin_end (flight_map_size + flightHudColumn's paddingEnd of
         14dp) — a per-size-bucket dimension, NOT a hardcoded number, because flight_map_size
         itself varies by bucket (130dp base, 180dp on the Smart Controller V3's values-w820dp).
         A hardcoded 144dp here was correct only for the base bucket and silently landed ~50dp
         short of the map's real edge on the V3 — caught and fixed 2026-08-04. marginBottom stays
         a plain 12dp: the map is pinned to the column's bottom by a weighted spacer regardless of
         the map's own size, so that number does not vary by bucket the way the width does. -->
    <LinearLayout
        android:id="@+id/flightResourceMonitorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="@dimen/flight_resource_row_margin_end"
        android:background="#B0000000"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView android:id="@+id/flightResSys" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResApp" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResCpu" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResGpu" style="@style/flightResCell" />
        <TextView android:id="@+id/flightResTak" style="@style/flightResCell" />

    </LinearLayout>

    <!-- Transient notice ("Home Point Set", etc.) — upper-left over the video, below the
         toolbar. Hidden by default; shown + auto-hidden in code. Same as DJI's fpvNotice. -->
    <TextView
        android:id="@+id/fpvNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="64dp"
        android:layout_marginStart="16dp"
        android:shadowColor="@color/tp_shadow"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text=""
        android:textColor="@color/tp_state_go"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- RIGHT-HAND HUD COLUMN, mirroring the DJI blueprint: telemetry readout, gimbal look
         angle, FAA ceiling, then the locked mini-map — all in ONE container with a weighted
         spacer, so they can't grow into each other at any screen size (the failure mode DJI
         hit when these were independently anchored). Replaces v1.2's full-width top/bottom
         HUD strips. -->
    <LinearLayout
        android:id="@+id/flightHudColumn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="12dp"
        android:paddingEnd="14dp">

        <!-- TOP HUD BLOCK: exposure controls and the telemetry readout, on one translucent panel.
             This text sits over live video whose brightness the pilot does not control, and light
             ground (snow, wet asphalt, a white roof) washed the readouts out. The drop-shadow in
             flightReadoutText helps but is not enough on its own.

             PANEL WIDTH IS THE MAP'S WIDTH, not wrap_content: the map is the widest thing in this
             column, and matching it keeps the exposure block, the readouts and the map flush on
             their right edge as one instrument stack. Letting the panel wrap would push it 8dp
             past the map on the padding alone, which reads as a misalignment. Children are
             match_parent so they inset with the panel's padding instead of overhanging it. -->
        <LinearLayout
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_panel"
            android:gravity="end"
            android:orientation="vertical">

            <!-- EV compensation slider biasing the auto-exposure, with the live ISO/shutter the
                 camera chose beneath it. -->
            <com.autel.sdksample.tak.EvSliderView
                android:id="@+id/evSlider"
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/hudText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="start" android:text="-2" />

                <TextView style="@style/hudText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="center"
                    android:letterSpacing="0.08" android:text="EV" android:textColor="@color/tp_accent" />

                <TextView style="@style/hudText" android:layout_width="0dp"
                    android:layout_weight="1" android:gravity="end" android:text="+2" />
            </LinearLayout>

            <!-- Thermal palette, under the exposure block (operator's placement, 2026-07-31).
                 It belongs with the image-quality controls rather than in the toolbar: it changes
                 how the picture looks, like EV does, and the toolbar is for actions.

                 Practical reason too — this appears and disappears with the IR mode, and in the
                 toolbar's horizontal row that shoved re-sync, LIVE and REC sideways every time
                 thermal was toggled. Here it grows the column downward into space the weighted
                 spacer already absorbs, so nothing a pilot reaches for moves. -->
            <TextView
                android:id="@+id/flightIrPaletteButton"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_zoom_pill"
                android:contentDescription="Toggle thermal palette (white hot / black hot)"
                android:gravity="center"
                android:text="WHITE HOT"
                android:textColor="@color/tp_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Wall clock, 24-hour, with seconds. Its real job is on the STREAM, not here: the
                 TAK feed is a screen capture, so a viewer can read this against their own clock
                 and know exactly how far behind real time they are. Software encoding added
                 latency, and "how delayed am I?" stopped being answerable by eye.

                 Seconds are the whole point — without them it cannot resolve the delay it exists
                 to show. It was monospace so the digits would not jitter as they change width;
                 dropped 2026-08-04 (operator) to match the rest of the HUD. -->
            <TextView
                android:id="@+id/fpvClock"
                style="@style/flightReadoutText"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="" />

            <TextView
                android:id="@+id/fpvOverlayText"
                style="@style/flightReadoutText"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="" />

            <!-- Gimbal look angle, directly under the aircraft lat/lon (operator, 2026-08-04).
                 Its own view so it can carry the same accuracy colour as the crosshair centre
                 ring: placement error scales as 1/sin^2(pitch), so a shallow angle is a real
                 accuracy warning rather than decoration. -->
            <TextView
                android:id="@+id/fpvGimbalPitch"
                style="@style/flightReadoutText"
                android:gravity="end"
                android:text="" />
        </LinearLayout>

        <!-- Absorbs leftover height so the TOP group (clock, telemetry) and the BOTTOM group
             (gimbal, RTH, FAA — pinned above the map) sit at opposite ends of the column instead
             of packed together in the middle. Moved here 2026-08-04 (was directly under the EV
             block, which packed EVERY readout into one cluster sitting over the video's vertical
             center — exactly where the obstacle-radar distance labels render, so the two
             overlapped and the radar text was unreadable). Splitting the column top/bottom clears
             that middle band for the radar. -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BOTTOM HUD BLOCK, pinned above the map. Order (operator, 2026-08-04):
             RTH, HOME, FAA. Same translucent backing as the top block, for the same reason. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_hud_panel"
            android:gravity="end"
            android:orientation="vertical">

            <!-- RTH altitude the AIRCRAFT reports, never the value Pre-Flight requested.
                 This is a safety readout: on 2026-08-02 a pilot flew two sorties believing the RTH
                 altitude was 50 ft while the aircraft was on a different value entirely, because the
                 write had been rejected and nothing said so. Showing the requested number here would
                 reproduce exactly that failure on the flight screen.
                 Shows a dashed placeholder when the aircraft has not answered, in amber: unknown
                 must look unknown. -->
            <TextView
                android:id="@+id/fpvRthAltitude"
                style="@style/flightReadoutText"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="RTH --" />

            <!-- HOME distance and bearing, between RTH and the FAA label (operator, 2026-08-04).
                 Split out of fpvOverlayText so it could move down here on its own. -->
            <TextView
                android:id="@+id/fpvHomeDistance"
                style="@style/flightReadoutText"
                android:layout_marginBottom="4dp"
                android:gravity="end"
                android:text="HOME — ft  —°T" />

            <!-- FAA UASFM ceiling; own view so it can turn amber/red independently. Advisory.
                 Last of the bottom group, directly above the map. -->
            <TextView
                android:id="@+id/fpvFaaCeiling"
                style="@style/flightReadoutText"
                android:gravity="end"
                android:text=""
                android:visibility="gone" />
        </LinearLayout>

        <!-- Locked TAK mini-map (operator's spec, matching the DJI flight screen): no pan, zoom
             or rotate — north-up, fixed zoom, recentred on the aircraft each telemetry tick,
             with a red home→aircraft line as the "which way back" reference. Tapping an inbound
             contact still works (see LockedMapView). -->
        <!-- The map is wrapped so the zoom toggle can sit ON it. The button is a SIBLING of the
             map, not a child: LockedMapView swallows every touch by design, so anything that
             needs to be tappable has to be layered above it rather than inside it. -->
        <!-- Has an id so the double-tap size toggle can resize it — see
             FlightActivity.toggleMapSize. -->
        <FrameLayout
            android:id="@+id/flightMapContainer"
            android:layout_width="@dimen/flight_map_size"
            android:layout_height="@dimen/flight_map_height">

            <com.autel.sdksample.tak.LockedMapView
                android:id="@+id/flightMap"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/flightMapZoomButton"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:gravity="center"
                android:background="@drawable/bg_map_zoom_button"
                android:textColor="@color/tp_text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:contentDescription="Mini-map zoom"
                android:text="WIDE" />

        </FrameLayout>

    </LinearLayout>
</FrameLayout>
