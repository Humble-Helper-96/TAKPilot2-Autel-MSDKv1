<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 1. Drone Settings — flight-safety limits, all optional (blank = leave the
             aircraft's own default alone). Feet in the UI, converted to meters for the SDK. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Drone Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Applied automatically when the aircraft connects. Leave a field blank to use the aircraft's own current setting."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="12dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max altitude (ft)" />
                <EditText
                    android:id="@+id/limitMaxAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 400"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max distance (ft)" />
                <EditText
                    android:id="@+id/limitMaxRadius"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 1600"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="RTH altitude (ft)" />
                <EditText
                    android:id="@+id/limitRthAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 100"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Signal-loss failsafe. Sent to the aircraft on connect via
             AutelFlyController.doEmergencyAction() — which despite its name is the policy
             SETTER (it emits MAV_CMD_SET_MSN_EMERGENCY); see FlightLimitsController's doc.
             Unlike the DJI blueprint there's no getter to read the value back, so the status
             line tells the pilot to confirm it in Autel's own app rather than implying more
             certainty than the SDK actually provides. -->
        <TextView style="@style/takLabelStyle" android:text="If the signal is lost" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What the aircraft does on its own if it loses the controller link — including if this app or the controller stops working. Return to Home is recommended."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/limitFailsafeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/failsafeGoHome"
                style="@style/takColumnRadio"
                android:text="Return Home" />

            <RadioButton
                android:id="@+id/failsafeHover"
                style="@style/takColumnRadio"
                android:text="Hover" />

            <RadioButton
                android:id="@+id/failsafeLand"
                style="@style/takColumnRadio"
                android:text="Land" />
        </RadioGroup>

        <TextView
            android:id="@+id/limitFailsafeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingTop="6dp" />

        <!-- Obstacle avoidance. A SUBSECTION of Drone Settings, placed under the signal-loss
             failsafe because both describe what the aircraft does on its own.

             DIFFERENT FROM EVERYTHING ELSE ON THIS SCREEN, deliberately. Every other control
             here stores a value and PUSHES it to the aircraft on connect. This one stores
             nothing and pushes nothing: it shows the aircraft's live state and changes it only
             when the pilot touches a switch.

             The reason is that a stale saved checkbox pushing "avoidance off" at connect would
             disable a safety system without anyone deciding to, and the pilot would have no
             reason to suspect it. The rest of this screen pushes LIMITS; this is a sensor
             system, which is a different category of risk. -->
        <TextView style="@style/takLabelStyle"
            android:text="Obstacle avoidance"
            android:paddingTop="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The aircraft sends these settings to the app. Connect the aircraft to see them. If you change a switch, the app sends the change to the aircraft immediately. The app does not keep these settings, and it does not change them when it connects."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/avoidStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="#FFB300"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="The aircraft is not connected." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/avoidSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obstacle avoidance system"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/avoidRth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Avoid obstacles in Return to Home"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/avoidLanding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Landing protection"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Control feel. Both values live on the REMOTE CONTROLLER, not the aircraft, and both
             are read live. "Normal" is LEARNED from the controller rather than hard-coded: there
             is no documented default and the pilot may have tuned these in Autel's own app, so a
             hard-coded number would quietly overwrite their setting. Like obstacle avoidance
             above, nothing here is saved and pushed at connect. -->
        <TextView style="@style/takLabelStyle"
            android:text="Control response"
            android:paddingTop="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Precision makes the gimbal wheel and the yaw of the aircraft move more slowly. Use it to point the camera accurately, or to make a smooth video. It does not change the speed of the aircraft. Connect the aircraft to use this control."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/ratesGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/ratesNormal"
                style="@style/takColumnRadio"
                android:enabled="false"
                android:text="Normal" />
            <RadioButton
                android:id="@+id/ratesPrecision"
                style="@style/takColumnRadio"
                android:enabled="false"
                android:text="Precision" />
        </RadioGroup>

        <TextView
            android:id="@+id/ratesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingTop="6dp" />

        <!-- Stick mode: READ-ONLY. The SDK names these USA/CHINA/JAPAN and the mapping to
             "Mode 1/2/3" is convention, not something confirmed on this aircraft. A wrong mode
             number in front of a pilot swaps throttle and pitch, so the app reports what the
             controller says and changes nothing. -->
        <TextView style="@style/takLabelStyle"
            android:text="Stick mode"
            android:paddingTop="16dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The app sends this mode to the controller each time it connects. Thus the sticks always do what you select here, even if a different app changed them. The ENTER FLIGHT card shows the mode before you fly."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/stickModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/stickMode1"
                style="@style/takColumnRadio"
                android:enabled="false"
                android:text="Mode 1" />
            <RadioButton
                android:id="@+id/stickMode2"
                style="@style/takColumnRadio"
                android:enabled="false"
                android:text="Mode 2" />
            <RadioButton
                android:id="@+id/stickMode3"
                style="@style/takColumnRadio"
                android:enabled="false"
                android:text="Mode 3" />
        </RadioGroup>

        <TextView
            android:id="@+id/stickModeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:paddingTop="6dp"
            android:textColor="#909090"
            android:textSize="12sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 2. Map Display — flight mini-map tile source. Street + Custom only; DJI's third
             "Hybrid" (satellite) option is deliberately absent here, since providing imagery
             means choosing a satellite tile provider, which is a licensing decision (operator's
             call, 2026-07-30). A pilot wanting imagery points Custom at their own provider. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Map Display"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <RadioGroup
            android:id="@+id/mapStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mapStyleStreet"
                style="@style/takColumnRadio"
                android:text="Street" />

            <RadioButton
                android:id="@+id/mapStyleCustom"
                style="@style/takColumnRadio"
                android:text="Custom" />
        </RadioGroup>

        <TextView style="@style/takLabelStyle"
            android:text="Custom tile URL (used when &quot;Custom&quot; is selected)" />
        <EditText
            android:id="@+id/mapCustomUrl"
            style="@style/takFieldStyle"
            android:hint="https://tiles.example.com/{z}/{x}/{y}.png"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Standard XYZ template — must include {z}, {x} and {y}. Tiles are cached offline as you view them."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <Button
            android:id="@+id/mapDisplaySaveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Save Map Display"
            android:textColor="#FFFFFF"
            android:backgroundTint="#37474F" />

        <!-- Offline map tiles. Same shape as the UASFM download below on purpose: centre,
             radius, check the size, then download. A pilot who has done one already knows
             how to do the other. -->
        <TextView style="@style/takLabelStyle"
            android:text="Offline map area"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiles you view are cached automatically. This downloads an area in advance, so the map works over ground you have not flown yet. Check the size first — the tile count grows with the square of the radius."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre latitude" />
                <EditText
                    android:id="@+id/mapCacheLat"
                    style="@style/takFieldStyle"
                    android:hint="61.2170"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre longitude" />
                <EditText
                    android:id="@+id/mapCacheLon"
                    style="@style/takFieldStyle"
                    android:hint="-149.8925"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Radius (mi)" />
                <EditText
                    android:id="@+id/mapCacheRadius"
                    style="@style/takFieldStyle"
                    android:hint="10"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/mapCacheUseLocationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Use My Location"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />

            <Button
                android:id="@+id/mapCacheCheckButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Check Size"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

        <LinearLayout style="@style/takFormRow"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/mapCacheDownloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Download Area"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E5C3A" />

            <Button
                android:id="@+id/mapCacheClearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Clear Cache"
                android:textColor="#FFFFFF"
                android:backgroundTint="#5C2E2E" />
        </LinearLayout>

        <TextView
            android:id="@+id/mapCacheStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9AC4FF"
            android:textSize="13sp"
            android:paddingTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. TAK Server Connection"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />



        <TextView style="@style/takLabelStyle" android:text="Server host" />
        <EditText
            android:id="@+id/takHost"
            style="@style/takFieldStyle"
            android:hint="tak.example.com"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Enroll port" />
                <EditText
                    android:id="@+id/takEnrollPort"
                    style="@style/takFieldStyle"
                    android:text="8446"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="CoT port" />
                <EditText
                    android:id="@+id/takCotPort"
                    style="@style/takFieldStyle"
                    android:text="8089"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/takUsername"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/takPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Drone callsign" />
                <EditText
                    android:id="@+id/takCallsign"
                    style="@style/takFieldStyle"
                    android:hint="TAKPilot2-EVO2"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <!-- Placed AFTER the fields it protects: a pilot reaches for this having just finished
             typing, not before starting (operator, 2026-07-31).

             Locking also disables Log Out, which CLEARS the saved enrollment — destructive, and
             exactly the kind of thing a lock should stand in front of. Enroll & Connect stays
             live: reconnecting is safe, and needing to reconnect is when a pilot must not be
             fighting a lock. -->
        <CheckBox
            android:id="@+id/takLockConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="#9AC4FF"
            android:text="Lock configuration (fields read-only)"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/takCameraPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send camera look-point (sensor point of interest)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/takConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enroll &amp; Connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/takDisconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Log Out (switch user)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555" />

        <TextView
            android:id="@+id/takStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- My Channels: pull the groups the logged-in user belongs to and pick which ones this
             drone's markers/PLI are directed to. Requires an active connection. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="My Channels"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Channels your TAK login belongs to. Selected ones receive this drone's PLI and markers (none selected = server default)."
            android:textColor="#909090"
            android:textSize="12sp" />

        <Button
            android:id="@+id/takPullChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pull Channels"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <TextView
            android:id="@+id/takChannelsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

        <LinearLayout
            android:id="@+id/takChannelsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Video Streaming"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />



        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Server host" />
                <EditText
                    android:id="@+id/videoHost"
                    style="@style/takFieldStyle"
                    android:hint="stream.example.com"
                    android:inputType="textUri" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Port" />
                <EditText
                    android:id="@+id/videoPort"
                    style="@style/takFieldStyle"
                    android:text="8554"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Broadcast ID" />
                <EditText
                    android:id="@+id/videoStreamId"
                    style="@style/takFieldStyle"
                    android:hint="UAS-CALLSIGN"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/videoUser"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/videoPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>

        <!-- After the fields it protects, same reasoning as the TAK section's lock. Quality and
             transport below stay editable: those are link decisions a pilot legitimately makes
             in the field, not server configuration. -->
        <CheckBox
            android:id="@+id/videoLockConfig"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="#9AC4FF"
            android:text="Lock configuration (fields read-only)"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />


        <TextView style="@style/takLabelStyle" android:text="Video quality (on-device transcode)" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transcoded on device with a 2s keyframe so remote viewers (ATAK) can join and recover cleanly. Aspect ratio is preserved. Published to a -Low path (e.g. Feed-A → Feed-A-Low) so the media server passes it through without re-transcoding. Standard is the default; Low suits marginal links."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/videoProfileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/videoProfileLow"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="Low\n480 max · 10fps\n475 kbps" />

            <RadioButton
                android:id="@+id/videoProfileStandard"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="Standard\n720 max · 15fps\n1.6 Mbps" />

            <RadioButton
                android:id="@+id/videoProfileHigh"
                style="@style/takColumnRadio"
                android:buttonTint="#1565C0"
                android:textSize="12sp"
                android:text="High\n1080 max · 15fps\n3.6 Mbps" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/videoTcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:buttonTint="#1565C0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use TCP transport (append ?tcp)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView style="@style/takLabelStyle"
            android:text="Full stream URL (push + advertised to ATAK)"
            android:paddingTop="8dp" />
        <TextView
            android:id="@+id/videoFullUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020"
            android:padding="12dp"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:text="rtsp://…" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Starting/stopping the stream is done from the LIVE pill on the flight screen."
            android:textColor="#909090"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 5. Elevation Data (DTED) — imported terrain regions for the local flight area.
             Feeds TerrainAgl + CameraSlantPoint's terrain-corrected SPoI. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. Elevation Data (DTED)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terrain regions for Sensor-Point-of-Interest ground accuracy — import a .zip per flight area (e.g. Anchorage.zip). Tiles are shared across regions; a repeat import overwrites in place."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/dtedUploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="+ Import Region"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />
            <Button
                android:id="@+id/dtedCleanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clean Unused Tiles"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dtedFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dtedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- 6. FAA Airspace Ceilings (UASFM) — downloaded once on wifi, read offline in flight.
             Advisory display only; nothing here is applied to the aircraft's flight limits. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6. FAA Airspace Ceilings (UASFM)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAA UAS Facility Map altitude ceilings, shown on the flight HUD. Download over wifi before you head out — it is read offline in flight. Advisory only: this shows altitudes the FAA is likely to authorise, it is NOT an authorisation, and it does not change the aircraft's altitude limit."
            android:textColor="#909090"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre latitude" />
                <EditText
                    android:id="@+id/uasfmLat"
                    style="@style/takFieldStyle"
                    android:hint="61.2170"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre longitude" />
                <EditText
                    android:id="@+id/uasfmLon"
                    style="@style/takFieldStyle"
                    android:hint="-149.8925"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Radius (mi)" />
                <EditText
                    android:id="@+id/uasfmRadius"
                    style="@style/takFieldStyle"
                    android:hint="50"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <Button
                android:id="@+id/uasfmUseLocationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Use My Location"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/uasfmCheckButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check Size"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/uasfmDownloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Download"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />
            <Button
                android:id="@+id/uasfmClearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear Data"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C" />
        </LinearLayout>

        <TextView
            android:id="@+id/uasfmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
