<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tp_bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 1. Aircraft Settings.
             LAID OUT TO FIT ONE SCREEN WITHOUT SCROLLING (operator, 2026-08-04), because this is
             the pre-flight check: a setting the pilot has to scroll to find is a setting that
             gets skipped. The controller is 1024dp WIDE and only ~720dp tall, so related
             controls are placed side by side across the width rather than stacked down it, and
             "Apply Updated Settings to Aircraft" sits last — after every value it sends.

             Helper prose was stripped for the same reason. This is a parameter screen, not a
             field guide; the labels say what each control is, and only CONSEQUENCE warnings
             (out-of-range, invalid battery pair, FAA advisory) earn on-screen text. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Aircraft Settings"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max altitude (ft)" />
                <EditText
                    android:id="@+id/limitMaxAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 400"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Max distance (ft)" />
                <EditText
                    android:id="@+id/limitMaxRadius"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 1600"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="RTH altitude (ft)" />
                <EditText
                    android:id="@+id/limitRthAltitude"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 100"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live range check. The aircraft rejects out-of-range values with "The command
             parameters are out of range" and KEEPS ITS OLD SETTING, which used to happen
             silently: on 2026-08-02 a pilot had 50 ft entered here while the aircraft was
             actually flying a 151 ft RTH. This line reads the aircraft's own accepted range
             (FlyControllerParameterRangeManager) and says so before takeoff. -->
        <TextView
            android:id="@+id/limitRangeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <!-- "If the signal is lost" WAS a control here until 2026-08-13, and it must not
             come back. RETURN TO HOME IS THE ONLY OPTION (operator, 2026-08-02). Hover and Land
             were removed deliberately: this app cannot verify that any of them took.
             doEmergencyAction() emits MAV_CMD_SET_MSN_EMERGENCY, that write is NOT acknowledged
             on this firmware (10s timeout on a clean channel), and the SDK exposes no getter to
             read it back. Offering a picker implied a control we do not have. Flight testing
             confirmed the aircraft returns home on link loss of its own accord, and the pilot
             now reads the real state — unknown, check Explorer — on the Enter Flight card. -->

        <!-- Control feel and stick mode, side by side. Both live on the REMOTE CONTROLLER rather
             than the aircraft and both are read live, so they belong together and neither is
             saved or pushed at connect.

             Control response: "Normal" is LEARNED from the controller rather than hard-coded —
             there is no documented default and the pilot may have tuned it in Autel's own app,
             so a hard-coded number would quietly overwrite their setting.

             Stick mode is READ-ONLY. The SDK names these USA/CHINA/JAPAN and the mapping to
             "Mode 1/2/3" is convention, not something confirmed on this aircraft. A wrong mode
             number in front of a pilot swaps throttle and pitch, so the app reports what the
             controller says and changes nothing. -->
        <LinearLayout style="@style/takFormRow"
            android:paddingTop="12dp">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Control response" />
                <RadioGroup
                    android:id="@+id/ratesGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/ratesNormal"
                        style="@style/takColumnRadio"
                        android:enabled="false"
                        android:text="Normal" />
                    <RadioButton
                        android:id="@+id/ratesPrecision"
                        style="@style/takColumnRadio"
                        android:enabled="false"
                        android:text="Precision" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Stick mode" />
                <RadioGroup
                    android:id="@+id/stickModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/stickMode1"
                        style="@style/takColumnRadio"
                        android:enabled="false"
                        android:text="Mode 1" />
                    <RadioButton
                        android:id="@+id/stickMode2"
                        style="@style/takColumnRadio"
                        android:enabled="false"
                        android:text="Mode 2" />
                    <RadioButton
                        android:id="@+id/stickMode3"
                        style="@style/takColumnRadio"
                        android:enabled="false"
                        android:text="Mode 3" />
                </RadioGroup>
                <TextView
                    android:id="@+id/stickModeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tp_text_tertiary"
                    android:textSize="12sp"
                    android:paddingTop="4dp"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- Obstacle avoidance. DIFFERENT FROM EVERYTHING ELSE ON THIS SCREEN, deliberately.
             Every other control here stores a value and PUSHES it to the aircraft on connect.
             This one stores nothing and pushes nothing: it shows the aircraft's live state and
             changes it only when the pilot touches a switch.

             The reason is that a stale saved checkbox pushing "avoidance off" at connect would
             disable a safety system without anyone deciding to, and the pilot would have no
             reason to suspect it. The rest of this screen pushes LIMITS; this is a sensor
             system, which is a different category of risk.

             The three switches are one row of columns, not three rows: they are read together
             ("what is the aircraft protecting me from right now") and their labels are short
             enough that stacking them only cost height. Labels drop the word "obstacle" — the
             section header above them already supplies it. -->
        <TextView style="@style/takLabelStyle"
            android:text="Obstacle avoidance"
            android:paddingTop="12dp" />

        <TextView
            android:id="@+id/avoidStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tp_state_unknown"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="The aircraft is not connected." />

        <LinearLayout style="@style/takFormRow"
            android:paddingTop="2dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/avoidSystem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:buttonTint="@color/tp_btn_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/avoidRth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:buttonTint="@color/tp_btn_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="During Return to Home"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/avoidLanding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:buttonTint="@color/tp_btn_primary" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Landing protection"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- The two battery percentages and their lock, together, directly above Apply.
             They sit here and not with the numeric limits because they are the last thing a
             pilot sets before they send the section, and the lock belongs beside what it locks
             — a lock at the far bottom of the section was a reach away from the fields it
             governs (operator, 2026-08-16).

             Three columns. The lock column takes layout_gravity="bottom" so the check box sits
             level with the two fields: the field columns are taller by one label, and without
             it the box floats at the top of the row.

             The label is "Lock battery levels" and nothing more. "(fields read-only)" said
             what a locked check box next to two fields already says.

             The pair are LABELLED AS THE PARAMETERS THEY ARE — Warning and Critical — not as
             the behaviour they produce (operator, 2026-08-04). "Return home at" / "Land at" was
             a conclusion about what the aircraft does with them, and conclusions drift: the
             Warning action is deferrable with the RTH button, so calling it "return home at"
             was already an overstatement. See FlightLimitsController.savedLowBatteryPct. -->
        <LinearLayout style="@style/takFormRow"
            android:paddingTop="12dp">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Battery Warning (%)" />
                <EditText
                    android:id="@+id/limitLowBattery"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 15"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Battery Critical (%)" />
                <EditText
                    android:id="@+id/limitCriticalBattery"
                    style="@style/takFieldStyle"
                    android:hint="e.g. 10"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn"
                android:layout_gravity="bottom">
                <CheckBox
                    android:id="@+id/limitBatteryLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/tp_accent"
                    android:text="Lock battery levels"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/limitBatteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp"
            android:paddingTop="4dp" />

        <!-- LAST in the section, after every value it sends. Resends everything above and then
             READS BACK what the aircraft actually holds: editing a field only saves it locally,
             this is the deliberate act that sends it, and the only thing that reports the
             aircraft's real state rather than what we asked for. Doubles as recovery — one tap
             re-asserts everything after a reconnect or an Autel Explorer link steal. -->
        <Button
            style="@style/TakButton.Primary"
            android:id="@+id/limitApplyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Apply Updated Settings to Aircraft" />

        <!-- Fills over the fixed read-back wait (see VERIFY_DELAY_MS / applyAllToAircraft).
             Determinate, not a spinner: the wait is a known, bounded duration, so showing how
             much of it remains is what actually reassures a pilot this hasn't frozen. -->
        <ProgressBar
            android:id="@+id/limitApplyProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/limitApplyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:text="Not sent yet." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/tp_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Video Streaming"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <!-- QUALITY FIRST, above the server configuration. It is the control a pilot reaches
             for in the air — dropping to Low on a marginal link — and the one setting in this
             section that is NOT behind the lock, for that reason. Everything below it is set
             once and then left alone. Putting the thing you touch often above the thing you
             touch once is the point (operator, 2026-08-16). -->
        <TextView style="@style/takLabelStyle" android:text="Video quality (on-device transcode)" />
        <RadioGroup
            android:id="@+id/videoProfileGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/videoProfileLow"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="Low" />

            <RadioButton
                android:id="@+id/videoProfileStandard"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="Standard" />

            <RadioButton
                android:id="@+id/videoProfileHigh"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="High" />

        </RadioGroup>

        <!-- TWO MEDIA SERVERS, ONE ACTIVE. A fleet flies on an internal mediaMTX on one callout
             and an external one on the next, and re-typing a host on a tailgate is how a stream
             gets lost. Each server keeps its own complete settings, including the encoding: an
             external server often needs a different profile from an internal one.

             The fields below edit whichever server is selected here. Selecting a server also
             makes it the live one — see setupVideoControls for what that costs and why it is
             acceptable (the stream is stopped whenever this screen is showing).

             The names come from the pilot and label the buttons, so the choice reads as
             "MMTX01 or MMTX03" and not "Server 1 or Server 2". -->
        <TextView style="@style/takLabelStyle" android:text="Active server" />
        <!-- Three columns: the two servers and the lock that guards the choice. The lock rides
             with the toggle instead of sitting at the foot of the section, because it is the
             toggle a pilot is most likely to hit by accident. Two thirds go to the servers so
             a long name still fits. -->
        <LinearLayout style="@style/takFormRow">
            <RadioGroup
                android:id="@+id/videoServerGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/videoServer1"
                    style="@style/takColumnRadio"
                    android:buttonTint="@color/tp_btn_info"
                    android:textSize="12sp"
                    android:text="Server 1" />

                <RadioButton
                    android:id="@+id/videoServer2"
                    style="@style/takColumnRadio"
                    android:buttonTint="@color/tp_btn_info"
                    android:textSize="12sp"
                    android:text="Server 2" />

            </RadioGroup>

            <LinearLayout style="@style/takColumn">
                <CheckBox
                    android:id="@+id/videoLockConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/tp_accent"
                    android:text="Lock configuration"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Server name" />
                <EditText
                    android:id="@+id/videoName"
                    style="@style/takFieldStyle"
                    android:hint="MMTX01"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Broadcast ID" />
                <EditText
                    android:id="@+id/videoStreamId"
                    style="@style/takFieldStyle"
                    android:hint="UAS-CALLSIGN"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Server host" />
                <EditText
                    android:id="@+id/videoHost"
                    style="@style/takFieldStyle"
                    android:hint="stream.example.com"
                    android:inputType="textUri" />
            </LinearLayout>

            <!-- ONE LOGIN FOR THE SERVER, not one per protocol (operator, 2026-08-29). SRT has
                 no login of its own: the stream id is an opaque string and the media server
                 reads a user and a password out of it by its own convention. -->
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/videoUser"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/videoPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>
        </LinearLayout>


        <TextView style="@style/takLabelStyle" android:text="Video codec" />
        <RadioGroup
            android:id="@+id/videoCodecGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/videoCodecH264"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="H.264" />

            <RadioButton
                android:id="@+id/videoCodecH265"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="H.265" />

        </RadioGroup>

        <!-- The consequence of this choice is invisible from the controller: an H.265 stream
             looks perfectly healthy here while browser viewers get an HTTP 500 they cannot
             interpret. Say so on the screen rather than making a pilot learn it in the field. -->
        <TextView
            android:id="@+id/videoCodecHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="11sp" />

        <!-- HOW THE VIDEO LEAVES THE CONTROLLER. This replaced a "Use TCP transport" checkbox
             on 2026-08-29. That control offered RTSP over UDP, which has no way to recover a
             lost packet — the wrong answer to the bad-link problem it looked like it solved.
             SRT is the right answer and it is here instead. RTSP is TCP always now.

             ⚠ This changes the PUSH only. The advertised address stays RTSP either way —
             see VideoTransport. -->
        <TextView style="@style/takLabelStyle" android:text="Video transport (to the server)" />
        <RadioGroup
            android:id="@+id/videoTransportGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/videoTransportRtsp"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="RTSP" />

            <RadioButton
                android:id="@+id/videoTransportSrt"
                style="@style/takColumnRadio"
                android:buttonTint="@color/tp_btn_info"
                android:textSize="12sp"
                android:text="SRT" />

        </RadioGroup>

        <!-- Same reasoning as the codec hint below the codec row: the trade is real, it is not
             visible from the controller, and the pilot makes this choice on a tailgate. -->
        <TextView
            android:id="@+id/videoTransportHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="11sp" />

        <!-- ONLY THE PORT DIFFERS BETWEEN THE PROTOCOLS, and SRT adds a passphrase. Each
             block keeps its own values, so a toggle back and forth restores what was last
             entered for that protocol (operator, 2026-08-29).

             ⚠ THE RTSP PORT IS USED WHILE SRT IS SELECTED, even though this block is hidden
             then: it is the port in the CoT address, because no TAK client plays SRT. Toggle
             back to RTSP to change it. -->
        <LinearLayout
            android:id="@+id/videoRtspBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/takFormRow">
                <LinearLayout style="@style/takColumn">
                    <TextView style="@style/takLabelStyle" android:text="RTSP port" />
                    <EditText
                        android:id="@+id/videoRtspPort"
                        style="@style/takFieldStyle"
                        android:text="8554"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ⚠ The passphrase encrypts the stream; it is not a credential. A server that sets
             srtPublishPassphrase refuses an unencrypted publisher BEFORE it reads the stream
             id, and it sends the same refusal it sends for a wrong password — so an empty
             passphrase looks exactly like a bad login (MediaMTX v1.20.0, 2026-08-29). -->
        <LinearLayout
            android:id="@+id/videoSrtBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/takFormRow">
                <LinearLayout style="@style/takColumn">
                    <TextView style="@style/takLabelStyle" android:text="SRT port" />
                    <EditText
                        android:id="@+id/videoSrtPort"
                        style="@style/takFieldStyle"
                        android:text="8890"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout style="@style/takColumn">
                    <TextView style="@style/takLabelStyle" android:text="Passphrase" />
                    <EditText
                        android:id="@+id/videoSrtPassphrase"
                        style="@style/takFieldStyle"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="The passphrase encrypts the stream. Leave it empty if the server has no passphrase. 10 to 79 characters."
                android:textColor="@color/tp_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView style="@style/takLabelStyle"
            android:text="Push address"
            android:paddingTop="8dp" />
        <TextView
            android:id="@+id/videoFullUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tp_surface_dialog"
            android:padding="12dp"
            android:textColor="@color/tp_state_go"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:text="rtsp://…" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/tp_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. TAK Server Connection"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />



        <!-- The host and the lock share a row. The lock is at the TOP of the section, beside
             the first field it guards, rather than at the foot: it was a long scroll away from
             everything it governs. It still disables Log Out further down — see takLockedFields
             — which is the destructive control it exists to stand in front of.

             The lock column takes layout_gravity="bottom" so the box sits level with the field,
             which is one label lower than the top of the row. -->
        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn"
                android:layout_weight="2">
                <TextView style="@style/takLabelStyle" android:text="Server host" />
                <EditText
                    android:id="@+id/takHost"
                    style="@style/takFieldStyle"
                    android:hint="tak.example.com"
                    android:inputType="textUri" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn"
                android:layout_gravity="bottom">
                <CheckBox
                    android:id="@+id/takLockConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/tp_accent"
                    android:text="Lock configuration"
                    android:textColor="@color/tp_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Enroll port" />
                <EditText
                    android:id="@+id/takEnrollPort"
                    style="@style/takFieldStyle"
                    android:text="8446"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="CoT port" />
                <EditText
                    android:id="@+id/takCotPort"
                    style="@style/takFieldStyle"
                    android:text="8089"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/takUsername"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Password" />
                <EditText
                    android:id="@+id/takPassword"
                    style="@style/takFieldStyle"
                    android:inputType="textPassword" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Aircraft callsign" />
                <EditText
                    android:id="@+id/takCallsign"
                    style="@style/takFieldStyle"
                    android:hint="TAKPilot2-EVO2"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/takCameraPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/tp_btn_primary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send the camera look-point to TAK"
                android:textColor="@color/tp_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            style="@style/TakButton.Primary"
            android:id="@+id/takConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enroll &amp; Connect" />

        <Button
            style="@style/TakButton.Neutral"
            android:id="@+id/takDisconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Log Out (switch user)" />

        <TextView
            android:id="@+id/takStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="14sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/tp_border" />

        <!-- My Channels: pull the groups the logged-in user belongs to and pick which ones this
             The server holds the state and enforces it — this is a mirror, not the control.
             Editing is behind Lock Config. Locking must NOT stop the rows reflecting the
             server, so the rows stay readable and only lose their touch response. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="My Channels"
            android:textColor="@color/tp_text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The TAK server holds these channels. A change here goes to the server."
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/takChannelsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp"
            android:text="" />

        <LinearLayout
            android:id="@+id/takChannelsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/tp_border" />

        <!-- 4. Elevation Data (DTED) — imported terrain regions for the local flight area.
             Feeds TerrainAgl + CameraSlantPoint's terrain-corrected SPoI. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Elevation Data (DTED)"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Improves marker position accuracy. Import one .zip per area; re-importing replaces it."
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
            style="@style/TakButton.Info"
                android:id="@+id/dtedUploadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="+ Import Region" />
            <Button
            style="@style/TakButton.Neutral"
                android:id="@+id/dtedCleanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clean Unused Tiles"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dtedFileList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/dtedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@color/tp_border" />

        <!-- 5. FAA Airspace Ceilings (UASFM) — downloaded once on wifi, read offline in flight.
             Advisory display only; nothing here is applied to the aircraft's flight limits. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5. FAA Airspace Ceilings (UASFM)"
            android:textColor="@color/tp_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAA altitude ceilings, shown on the flight screen. Download on wifi before you travel.\n\n⚠ Advice only — NOT an authorisation, and it does not change the aircraft\u2019s altitude limit."
            android:textColor="@color/tp_text_tertiary"
            android:textSize="12sp"
            android:paddingBottom="10dp" />

        <LinearLayout style="@style/takFormRow">
            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre latitude" />
                <EditText
                    android:id="@+id/uasfmLat"
                    style="@style/takFieldStyle"
                    android:hint="61.2170"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Centre longitude" />
                <EditText
                    android:id="@+id/uasfmLon"
                    style="@style/takFieldStyle"
                    android:hint="-149.8925"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout style="@style/takColumn">
                <TextView style="@style/takLabelStyle" android:text="Radius (mi)" />
                <EditText
                    android:id="@+id/uasfmRadius"
                    style="@style/takFieldStyle"
                    android:hint="50"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <Button
            style="@style/TakButton.Neutral"
                android:id="@+id/uasfmUseLocationButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Use My Location"
                android:textSize="12sp" />
            <Button
            style="@style/TakButton.Neutral"
                android:id="@+id/uasfmCheckButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check Size"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button
            style="@style/TakButton.Info"
                android:id="@+id/uasfmDownloadButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Download" />
            <Button
            style="@style/TakButton.Danger"
                android:id="@+id/uasfmClearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear Data"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/uasfmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:textColor="@color/tp_text_secondary"
            android:textSize="13sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
