<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAK Server Connection"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView style="@style/takLabelStyle" android:text="Server host" />
        <EditText
            android:id="@+id/takHost"
            style="@style/takFieldStyle"
            android:hint="tak.example.com"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Enroll port" />
                <EditText
                    android:id="@+id/takEnrollPort"
                    style="@style/takFieldStyle"
                    android:text="8446"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="CoT port" />
                <EditText
                    android:id="@+id/takCotPort"
                    style="@style/takFieldStyle"
                    android:text="8089"
                    android:inputType="number" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/takLabelStyle" android:text="Username" />
        <EditText
            android:id="@+id/takUsername"
            style="@style/takFieldStyle"
            android:inputType="text" />

        <TextView style="@style/takLabelStyle" android:text="Password" />
        <EditText
            android:id="@+id/takPassword"
            style="@style/takFieldStyle"
            android:inputType="textPassword" />

        <TextView style="@style/takLabelStyle" android:text="Drone callsign" />
        <EditText
            android:id="@+id/takCallsign"
            style="@style/takFieldStyle"
            android:hint="TAKPilot2-M30"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/takCameraPoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#2E7D32" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send camera look-point (sensor point of interest)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/takConnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Enroll &amp; Connect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/takDisconnectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Log Out (switch user)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555" />

        <TextView
            android:id="@+id/takStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <!-- My Channels: pull the groups the logged-in user belongs to and pick which ones this
             drone's markers/PLI are directed to. Requires an active connection. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="My Channels"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Channels your TAK login belongs to. Selected ones receive this drone's PLI and markers (none selected = server default)."
            android:textColor="#909090"
            android:textSize="12sp" />

        <Button
            android:id="@+id/takPullChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pull Channels"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <TextView
            android:id="@+id/takChannelsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#B0B0B0"
            android:textSize="13sp"
            android:text="" />

        <LinearLayout
            android:id="@+id/takChannelsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video to TAK (MediaMTX)"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <TextView style="@style/takLabelStyle"
            android:text="Server host / endpoint" />
        <EditText
            android:id="@+id/videoHost"
            style="@style/takFieldStyle"
            android:hint="stream.example.com"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Port" />
                <EditText
                    android:id="@+id/videoPort"
                    style="@style/takFieldStyle"
                    android:text="8554"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">
                <TextView style="@style/takLabelStyle" android:text="Username" />
                <EditText
                    android:id="@+id/videoUser"
                    style="@style/takFieldStyle"
                    android:inputType="text" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/takLabelStyle" android:text="Password" />
        <EditText
            android:id="@+id/videoPassword"
            style="@style/takFieldStyle"
            android:inputType="textPassword" />

        <TextView style="@style/takLabelStyle"
            android:text="Video broadcast identifier (stream path)" />
        <EditText
            android:id="@+id/videoStreamId"
            style="@style/takFieldStyle"
            android:hint="UAS-CALLSIGN"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/videoTcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:buttonTint="#1565C0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use TCP transport (append ?tcp)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/videoLowBandwidth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#1565C0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low bandwidth (480p/15fps, transcoded, appends -Low)"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView style="@style/takLabelStyle"
            android:text="Full stream URL (push + advertised to ATAK)" />
        <TextView
            android:id="@+id/videoFullUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#202020"
            android:padding="12dp"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:text="rtsp://…" />

        <Button
            android:id="@+id/videoStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Start Video"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <Button
            android:id="@+id/videoStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop Video"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555" />

        <TextView
            android:id="@+id/videoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:text="" />

    </LinearLayout>
</ScrollView>
