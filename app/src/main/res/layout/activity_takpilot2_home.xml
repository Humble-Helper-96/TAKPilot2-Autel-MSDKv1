<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0E0E10"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: logo + status + quick toggles -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Logo + TAK connection indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/takpilot2_logo"
                android:layout_marginEnd="12dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Bound to the same string as the launcher label so the two can't drift
                     apart the next time the app is renamed. Sized to the blueprint's 22sp
                     (with its 64dp logo) rather than the old 24sp/100dp: "TAKPilot2 - Autel
                     640T" is twice the length of the old "TAKPilot2", and at the larger sizes
                     it ran out of column width and clipped at maxLines=1. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <View
                        android:id="@+id/homeTakDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tak_status_dot" />
                    <TextView
                        android:id="@+id/homeTakStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAK: Disconnected"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Controls -->
        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Quick Controls" />
            <Button
                android:id="@+id/homeTakSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pre-Flight Setup"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
            <Button
                android:id="@+id/homeQuit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="STOP / QUIT"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B71C1C" />
            <Button
                android:id="@+id/homeFieldGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Field Guide"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />
            <Button
                android:id="@+id/homeDataSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Data Sync"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/homeDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Debug Log"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: the whole card IS the Enter Flight button (clickable, ripple feedback), same
         as the DJI blueprint.

         Sizes here are the blueprint's, not arbitrary, and they carry a height budget: this
         is a fixed-height column whose weighted spacer collapses to zero when the contents
         exceed the screen, after which the LAST child is pushed off the bottom and silently
         clipped (the v1.1 failure class — see TAKPilot2-Autel-HANDOFF.md). v1.2 had a 30sp
         title, an 84dp logo and a redundant 56dp "Enter Flight" button BELOW the already-
         clickable card, which together needed ~362dp — over a 360dp landscape phone. Dropping
         to the blueprint's 26sp/72dp and replacing the duplicate button with its tap hint
         both matches DJI and buys back ~60dp. Don't reinstate the button: the card is the
         tap target, so it was never doing anything the card didn't. -->
    <LinearLayout
        android:id="@+id/homeEnterFlight"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/home_flight_card"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp">

        <View android:layout_width="0dp" android:layout_height="0dp" />

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/takpilot2_logo"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTER FLIGHT"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live FPV · Telemetry · TAK"
            android:textColor="#9AC4FF"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <!-- Aircraft info, centered under the title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="18dp">
            <TextView style="@style/homeCardTitle" android:text="Aircraft"
                android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeAircraft" style="@style/homeCardValue"
                android:text="—" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeSdk" style="@style/homeCardSub"
                android:text="MSDK —" android:layout_gravity="center_horizontal" />
            <!-- Obstacle avoidance. Blank until the aircraft reports, because "unknown"
                 and "disabled" must not look the same to a pilot. -->
            <TextView android:id="@+id/homeAvoidance" style="@style/homeCardSub"
                android:text="" android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp" android:textStyle="bold" />
            <!-- What the sticks and the gimbal wheel will actually do. These are ENFORCED from
                 Pre-Flight at connect, so this is a statement of fact, not a hope — and it is
                 here rather than on the flight screen because the pilot needs it BEFORE they
                 start flying, not after. -->
            <TextView android:id="@+id/homeStickMode" style="@style/homeCardSub"
                android:text="" android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp" android:textStyle="bold" />
            <TextView android:id="@+id/homeControlResponse" style="@style/homeCardSub"
                android:text="" android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp" android:textStyle="bold" />
            <!-- Shown while the connect-time pushes are still landing. The card refuses taps
                 until it clears, so a pilot cannot reach the flight screen before the aircraft
                 has actually been configured — see TakPilotHomeActivity.startInitializing. -->
            <TextView android:id="@+id/homeInitializing" style="@style/homeCardSub"
                android:text="INITIALIZING"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Aircraft picture. Fills the dead space between the SDK line and the tap hint, and
             doubles as an at-a-glance "the aircraft is here" cue.

             INVISIBLE (not GONE) when no aircraft is connected: GONE would let the spacer
             collapse and move "TAP TO ENTER" up the card, so the layout would jump every time
             the aircraft connects or drops. Reserving the space keeps the card still. -->
        <ImageView
            android:id="@+id/homeAircraftImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="invisible"
            android:contentDescription="Connected aircraft"
            android:src="@drawable/evo2_aircraft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="TAP TO ENTER ›"
            android:textColor="#9AC4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
    </LinearLayout>
</LinearLayout>
