<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0E0E10"
    android:padding="20dp"
    android:baselineAligned="false">

    <!-- LEFT: logo + status + quick toggles -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:paddingEnd="20dp"
        android:scrollbars="none"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Logo + TAK connection indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">
            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/takpilot2_logo"
                android:layout_marginEnd="12dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAKPilot2"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">
                    <View
                        android:id="@+id/homeTakDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/tak_status_dot" />
                    <TextView
                        android:id="@+id/homeTakStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAK: Disconnected"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Controls -->
        <LinearLayout style="@style/homeCard">
            <TextView style="@style/homeCardTitle" android:text="Quick Controls" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="6dp">
                <CheckBox android:id="@+id/homeVideoToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Stream video to TAK" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="6dp">
                <CheckBox android:id="@+id/homeCameraPointToggle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:buttonTint="#1565C0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Camera FOV / look-point" android:textColor="#DDDDDD" android:textSize="15sp" />
            </LinearLayout>
            <Button
                android:id="@+id/homeButtonMapping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Customize RC Buttons"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/homeTakSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TAK Setup"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />
            <Button
                android:id="@+id/homeDataSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Data Sync"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
            <Button
                android:id="@+id/homeDebug"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Debug"
                android:textColor="#FFFFFF"
                android:backgroundTint="#37474F" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- RIGHT: card with logo, title, aircraft info, and Enter button. The whole card is
         the tap target (not just the button strip at the bottom) — it reads visually as
         one big tile, so it should behave like one. -->
    <LinearLayout
        android:id="@+id/homeEnterFlightCard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/home_flight_card"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp">

        <View android:layout_width="0dp" android:layout_height="0dp" />

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@drawable/takpilot2_logo"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENTER FLIGHT"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live FPV · Telemetry · TAK"
            android:textColor="#9AC4FF"
            android:textSize="15sp"
            android:layout_marginTop="6dp" />

        <!-- Aircraft info, centered under the title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="24dp">
            <TextView style="@style/homeCardTitle" android:text="Aircraft"
                android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeAircraft" style="@style/homeCardValue"
                android:text="—" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeSdk" style="@style/homeCardSub"
                android:text="MSDK —" android:layout_gravity="center_horizontal" />
            <TextView android:id="@+id/homeBattery" style="@style/homeCardSub"
                android:text="Battery —" android:layout_gravity="center_horizontal" />
        </LinearLayout>

        <!-- Spacer pushes the button to the bottom -->
        <View android:layout_width="0dp" android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/homeEnterFlight"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enter Flight"
            android:textColor="#0D47A1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/home_enter_button" />
    </LinearLayout>
</LinearLayout>
